SECRET_KEY=replace-this-in-production
DATABASE_PATH=backend/data/students.db
UPLOAD_FOLDER=backend/uploads
# LangGraph 报告流程；未配置 Key 或设为 false 时使用本地模板
AI_REPORT_ENABLED=true
# 凭证字段提取与一致性比对；复用下方 OpenAI 兼容模型配置
AI_CREDENTIAL_REVIEW_ENABLED=true
# 基于教师教材知识库的学生辅导对话
AI_TUTOR_ENABLED=true
# 可选的 AI 可观测性；未配置时本地 RAG 调试记录仍然可用
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_PROJECT_ID=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=系统管理员
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TIMEZONE=Asia/Shanghai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# 首次使用会下载模型，也可以填写已下载的本地路径
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Celery prefork 在 macOS 上不能稳定使用 Metal/MPS；默认使用 CPU
EMBEDDING_DEVICE=cpu
# 模型已下载或使用本地路径时可开启，后端启动不再检查远程更新
EMBEDDING_LOCAL_ONLY=false

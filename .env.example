SECRET_KEY=replace-this-in-production
DATABASE_PATH=backend/data/students.db
UPLOAD_FOLDER=backend/uploads
# LangGraph 报告流程；未配置 Key 或设为 false 时使用本地模板
AI_REPORT_ENABLED=true
# 凭证字段提取与一致性比对；复用下方 OpenAI 兼容模型配置
AI_CREDENTIAL_REVIEW_ENABLED=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TIMEZONE=Asia/Shanghai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# 首次使用会下载模型，也可以填写已下载的本地路径
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# 模型已下载或使用本地路径时可开启，后端启动不再检查远程更新
EMBEDDING_LOCAL_ONLY=false
